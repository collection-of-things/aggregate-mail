---
import { CAFE_REPO, GITHUB_REPO } from "../lib/site";

const sections = [
  { href: "#features", label: "Features" },
  { href: "#privacy", label: "Privacy" },
  { href: "#download", label: "Download" },
  { href: "#faq", label: "FAQ" },
];
---
<header class="bar">
  <div class="wrap bar-inner">
    <a class="bar-mark" href="#top" aria-label="Emc² home"><span class="brand-lockup" aria-hidden="true"></span><span class="brand-symbol" aria-hidden="true"></span></a>
    <nav class="bar-links" aria-label="Sections">
      {sections.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>
    <div class="bar-actions">
      <details class="bar-menu">
        <summary class="bar-menu-toggle">
          <span class="visually-hidden">Menu</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <nav aria-label="Mobile sections">
          {sections.map(({ href, label }) => <a href={href}>{label}</a>)}
        </nav>
      </details>
      <button class="bar-icon bar-theme" type="button" data-theme-toggle aria-label="Switch to dark theme">
        <svg class="bar-theme-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
        </svg>
        <svg class="bar-theme-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
        </svg>
      </button>
      <a class="bar-gh bar-repo" href={GITHUB_REPO} rel="noreferrer" target="_blank" title="Star Emc² on GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z" />
        </svg>
        <span class="bar-gh-label">GitHub</span>
        <span class="bar-stars" data-count-label="stars" hidden>
          <span class="num" data-count="stars">0</span>
          <span class="visually-hidden"> stars</span>
        </span>
      </a>
      <a class="bar-gh bar-repo bar-cafe" href={CAFE_REPO} rel="noreferrer" target="_blank" title="Emc² on git.cafe">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 9h11v4.5a5.5 5.5 0 0 1-5.5 5.5A5.5 5.5 0 0 1 5 13.5Z" />
          <path d="M16 10.5h1.2a2.5 2.5 0 0 1 0 5H15.5" />
          <path d="M8.5 6c-.8-.9.8-1.6 0-2.5M12.5 6c-.8-.9.8-1.6 0-2.5" />
          <path d="M3.5 21h14" />
        </svg>
        <span class="bar-gh-label">git.cafe</span>
      </a>
      <a class="btn btn-fill btn-sm bar-download" href="#download">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12m-4-4 4 4 4-4M4 16v4h16v-4" />
        </svg>
        Download
      </a>
    </div>
  </div>
</header>

<script>
  import { currentTheme, onThemeChange, setTheme, type Theme } from "../lib/theme";

  /* the toggle names the theme it switches to */
  const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  if (themeToggle) {
    const label = (theme: Theme) =>
      themeToggle.setAttribute("aria-label", theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
    label(currentTheme());
    onThemeChange(label);
    themeToggle.addEventListener("click", () => {
      setTheme(currentTheme() === "dark" ? "light" : "dark");
    });
  }

  const menu = document.querySelector<HTMLDetailsElement>(".bar-menu");
  if (menu) {
    const toggle = menu.querySelector("summary");

    // Keep native details navigation usable after following a link or leaving it.
    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) menu.open = false;
    });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return;
      menu.open = false;
      toggle?.focus();
    });
    matchMedia("(min-width: 1025px)").addEventListener("change", (event) => {
      if (event.matches) menu.open = false;
    });
  }
</script>
