# Optional connection settings only. Browser security startup variables must
# be exported separately; see README.md#local-browser-access.
APP_URL=http://127.0.0.1:5173
# Google Cloud: enable Gmail API, create a Web OAuth client, add your account
# as a test user and register APP_URL + /api/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Email metadata is sent to OpenAI only when this key is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
